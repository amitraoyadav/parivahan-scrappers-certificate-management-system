# ==============================================================================
# PARIVAHAN SCRAPPERS — FRESH CERTIFICATE MANAGEMENT SYSTEM
# Enter real production secrets directly in Vercel Environment Variables.
# NEVER commit populated .env files or service account JSON files to GitHub.
# ==============================================================================

# Fresh Google Cloud Firestore (Service Account Authentication — Spark Free Plan compatible)
# Note: Use (default) for FIREBASE_DATABASE_ID on Firebase Spark (Free) plan.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=(default)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Role-Based Authentication Credentials (Server-Side Only)
ADMIN_USERNAME=
ADMIN_PASSWORD=
MAIN_ADMIN_PASSWORD=
ADMIN_PROTECTED_PASSWORD=
ADMIN_DELETE_PASSWORD=
ADMIN_SESSION_SECRET=

# Scheduled Backup Cron Authorization
CRON_SECRET=

# Public Website Domain (used for QR Verification URLs)
PUBLIC_APP_URL=

# Optional Independent Google Drive Backup Integration (leave empty to disable)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
